# Copy to .env to override docker compose defaults. All values are optional.

POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets
POSTGRES_DB=tickets

# Host ports
DB_PORT=5433
API_PORT=8000
WEB_PORT=5173
PROD_PORT=8080

# Emails that are admins (comma-separated). The first one is created on startup with
# BOOTSTRAP_ADMIN_PASSWORD (local default: adam-demo-password) if it doesn't exist yet.
ADMIN_EMAILS=adam@example.com
LOG_LEVEL=INFO

# Set to true on macOS/Windows if the frontend doesn't hot-reload inside Docker.
VITE_USE_POLLING=false
