          }
        },
        "type": "object",
        "required": [
          "comment"
        ],
        "title": "CommentOut"
      },
      "CreatedVia": {
        "type": "string",
        "enum": [
          "ui",
          "agent"
        ],
        "title": "CreatedVia"
      },
      "EventType": {
        "type": "string",
        "enum": [
          "created",
