              }
            ],
            "title": "Name"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "is_triager": {
            "type": "boolean",
            "title": "Is Triager"
          },
          "is_admin": {
            "type": "boolean",
            "title": "Is Admin"
          },
          "agent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "role",
          "is_triager",
          "is_admin",
          "agent_id"
        ],
        "title": "MeOut"
      },
      "PersonOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "email"
        ],
        "title": "PersonOut"
      },
      "Role": {
        "type": "string",
        "enum": [
          "member",
          "triager",
          "admin"
        ],
        "title": "Role"
      },
      "RoleUpdateIn": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "member",
              "triager"
            ],
            "title": "Role",
            "description": "Grant or revoke the triager role"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role"
        ],
        "title": "RoleUpdateIn"
      },
      "Severity": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ],
        "title": "Severity"
      },
      "Status": {
        "type": "string",
        "enum": [
          "open",
          "in_progress",
          "resolved",
          "closed"
        ],
        "title": "Status"
      },
      "TicketCreateIn": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 3,
            "title": "Title",
            "description": "Short, specific summary of what is broken (not 'bug')."
          },
          "target_app": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Target App",
            "description": "Name of the app the bug is in, e.g. 'reports'."
          },
          "severity": {
            "$ref": "#/components/schemas/Severity",
            "description": "critical = outage/data loss/security; high = main feature unusable; medium = degraded with workaround; low = cosmetic.",
            "default": "medium"
          },
          "description": {
            "type": "string",
            "maxLength": 10000,
            "title": "Description",
            "description": "What the reporter said, in their words plus context.",
            "default": ""
          },
          "steps_to_reproduce": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 5000
              },
              {
                "type": "null"
              }
            ],
            "title": "Steps To Reproduce",
            "description": "Only steps the reporter actually gave. Never invent."
          },
          "expected_behavior": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Behavior"
          },
          "actual_behavior": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual Behavior"
          },
          "environment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Environment",
            "description": "Browser/OS/version/account, if known."
          },
          "confidential": {
            "type": "boolean",
            "title": "Confidential",
            "description": "True for security issues or sensitive data; hides it from non-triagers.",
            "default": false
          },
          "request_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Key",
            "description": "Idempotency key. Retrying with the same key returns the original ticket instead of creating a duplicate."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "target_app"
        ],
        "title": "TicketCreateIn"
      },
      "TicketCreateOut": {
        "properties": {
          "ticket": {
            "$ref": "#/components/schemas/TicketOut"
          },
          "created": {
            "type": "boolean",
            "title": "Created",
            "description": "False when this call matched an earlier identical request"
          },
          "deduplicated": {
            "type": "boolean",
            "title": "Deduplicated"
          }
        },
        "type": "object",
        "required": [
          "ticket",
          "created",
          "deduplicated"
        ],
        "title": "TicketCreateOut"
      },
      "TicketDetailOut": {
