                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Search workspace members who have used the app (triagers only)",
        "operationId": "list_users_api_v1_users_get",
