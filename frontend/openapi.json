    "/api/v1/tickets/{number}": {
      "get": {
        "tags": [
          "tickets"
        ],
        "summary": "A ticket with its activity and your permissions",
        "operationId": "get_ticket",
        "parameters": [
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Ticket number, e.g. 42 for #42",
              "title": "Number"
            },
            "description": "Ticket number, e.g. 42 for #42"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketDetailOut"
